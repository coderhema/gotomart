{
  "name": "gotomart",
  "version": "0.1.2",
  "description": "WhatsApp-native AI marketplace - Backend API & Landing Page",
  "private": true,
  "workspaces": [
    "landing"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:landing": "cd landing && npm run dev",
    "build:landing": "cd landing && npm install && npm run build",
    "preview:landing": "cd landing && npm run preview",
    "test": "node tests/test_integration.js",
    "lint": "eslint src/",
    "test:purchase": "node tests/test_purchase_flow.js",
    "test:live-golden": "node tests/test_live_g1_g2_g7.js",
    "test:all": "node tests/test_integration.js && node tests/test_purchase_flow.js",
    "start:live-test": "node -e \"process.env.ENABLE_LIVE_TEST='1'; require('./src/index.js')\""
  },
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.91.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.77.0",
    "qrcode-terminal": "^0.12.0",
    "twilio": "^6.1.2"
  },
  "devDependencies": {
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
