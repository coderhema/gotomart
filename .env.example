# Twilio WhatsApp (use instead of Meta if blocked)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API (backup)
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_ACCESS_TOKEN=your_meta_access_token
META_VERIFY_TOKEN=your_meta_verify_token

# Airtable
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_VENDORS_TABLE=Vendors
AIRTABLE_SESSIONS_TABLE=Sessions
AIRTABLE_ORDERS_TABLE=Orders

# Bachs (Payments)
BACHS_API_KEY=your_bachs_api_key
BACHS_WEBHOOK_SECRET=your_bachs_webhook_secret

# Cerebras Inference
CEREBRAS_API_KEY=your_cerebras_api_key

# Server
PORT=3000
BASE_URL=http://localhost:3000
